# Copy to .env and adjust. Every variable has a local-development default in
# backend/config/settings.py, so only override what differs on your machine.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=travelblog
POSTGRES_USER=travelblog
POSTGRES_PASSWORD=travelblog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
