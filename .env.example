# Copy to .env and adjust. Docker Compose reads it for every service, and every
# variable has a default, so only override what differs on your machine.
# DJANGO_SECRET_KEY is required when DJANGO_DEBUG is off.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=travelblog
POSTGRES_USER=travelblog
POSTGRES_PASSWORD=travelblog
POSTGRES_HOST=localhost
# The host port Docker Compose publishes the database on, and the port the backend
# uses when run outside Docker. Inside Compose the backend always reaches db:5432.
POSTGRES_PORT=5433
